# Copy to .env.local and fill in after provisioning AWS.
# VITE_MOCK=true runs the UI with no backend (fake login + simulated streaming).
VITE_MOCK=true

# Cognito User Pool (app client WITHOUT secret)
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# API Gateway WebSocket endpoint (include stage, no query string)
VITE_WS_URL=wss://abc123.execute-api.us-east-1.amazonaws.com/prod

# Daily query limit (must match the Lambda Authorizer)
VITE_DAILY_LIMIT=50
